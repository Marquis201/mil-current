"VertexlitGeneric"
{
	"$basetexture" "models/hoff/weapons/briefcasebomb/t5_weapon_briefcase_bomb_liquid_c_blue"
	"$surfaceprop" "Default"
	"$color" "255 0 0"
	"Proxies"
	{
		"TextureScroll"
		{
			"texturescrollvar" "$baseTextureTransform"
			"texturescrollrate" "-1"
			"texturescrollangle" "0.00"
		}
		"ConveyorScroll"
		{
			"texturescrollvar" "$baseTextureTransform"
		}
	}
}